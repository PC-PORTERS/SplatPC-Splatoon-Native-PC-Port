# Build outputs, downloads and the installed game are created by Setup.bat /
# setup.sh and must never be committed (they contain or derive from your game
# files).
/build/
/Game/

# Auto-fetched third-party headers
recompiler/third_party/nlohmann/
recompiler/third_party/miniaudio.h

# Never commit game files
*.rpx
*.rpl
*.wud
*.wux
*.szs
*.pack
*.bfres
content/
meta/
mlc01/
vulkan_cache/
vulkan_cache.zip
save/

/Gambit/

# Generated from Manifest/ at build time by recompiler/tools/plt_resolver.py.
# The manifest is the source of truth; these files are outputs and must never
# be committed. A clean checkout regenerates them when the port is configured.
/recompiler/port/os/gambit_plt_auto.cpp
/recompiler/port/os/coreinit/coreinit_addrs.h
/recompiler/port/os/gx2/gx2_addrs.h
/recompiler/port/os/padscore/padscore_addrs.h
/recompiler/port/os/snd_core/snd_core_addrs.h
/recompiler/port/os/stubs/stubs_addrs.h
/recompiler/port/os/vpad/vpad_addrs.h

# Tools
__pycache__/
*.pyc
.vs/
.vscode/

# Local developer artifacts: screenshots, frame dumps, logs and backups made
# while testing. They stay on disk but are never committed.
/backups/
/frame_dumps*/
/gameplay_dumps/
/validation_results/
/tools/*
!/tools/nexlab/
!/tools/tests/
!/tools/boss/
__pycache__/
online_identity.ini
server.json
/*.png
/*.log
/link_cmd.txt
/user_prompt_full.txt
/original_cpp_emitter.cpp
/check_parts.py

# scripts/: only the maintained tools are tracked. One-off experiment scripts
# can live here without showing up in git status. Add new tools below.
/scripts/*
!/scripts/Setup.ps1
!/scripts/hd_textures.py
!/scripts/install-hooks.sh
!/scripts/git-hooks/
!/scripts/git-hooks/*

# v288 update tooling (tracked on purpose)
!/scripts/Build-Update.ps1
!/scripts/Launch-Update.ps1
!/scripts/Install-Update.ps1
!/scripts/tests/
!/scripts/tests/**

# Multiplayer launchers
!/scripts/Splatoon-Login.ps1
!/scripts/Launch-Duo-Public.ps1
!/scripts/Launch-Duo.ps1
!/scripts/Launch-Duo-LAN.ps1
!/scripts/Launch-Duo-VPN.ps1
!/scripts/Launch-Online.ps1
!/scripts/Update-Check.ps1
!/scripts/Update-Apply.ps1
!/scripts/allowed_signers
!/scripts/server.public.txt

# The launcher shortcut that Setup may put in the install folder
*.lnk
