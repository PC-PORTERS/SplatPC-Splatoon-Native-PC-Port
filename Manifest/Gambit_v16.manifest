[hooks]
# Guest function entries wrapped so the port can attach opt-in host hooks.
# Without a registered hook, a wrapper calls the original body directly.
hash = 0xA359D087A60635C1
0x026227C8 = hook  # player motion object constructor
0x0262304C = hook  # player motion per-frame update
0x025CF3A0 = hook  # animation controller (called by the constructor)
0x025CFB18 = hook
0x025D0BF8 = hook
0x025CFFC4 = hook  # animation controller (called by the update)
0x025D06A4 = hook
0x025D0750 = hook
0x025D07F8 = hook
0x025D08B0 = hook
0x0281ADB4 = hook  # sead::LookAtCamera::doUpdateMatrix (gx2_env_light.cpp: camera distance, height, fly camera)
0x0200F24C = hook  # agl camera: set field of view in degrees (gx2_env_light.cpp widens the plaza camera)

[patches]
# 0xADDR = instruction, applied before recompilation.
# The instruction is PowerPC assembly (cmpwi, li, stw, b, ...).
# Branch targets are absolute guest addresses.
hash = Undefined

[globals]
# Guest addresses the port code needs by name (not covered by a hash).
# rbrew_game_address() and the RBREW_GAME_* constants are generated from this section.
allocator            = 0x101D2554
sda                  = 0x10256C80
ctors                = 0x101BFA54
ctors_done           = 0x101CC020
tls_handle           = 0x101C98F0
plt_begin            = 0x02D00000
plt_end              = 0x02D10000
heap_alloc_slot      = 0x02D0B8F8
heap_alloc_ex_slot   = 0x02D0B900
heap_free_slot       = 0x02D0B908
fopen_max_slot       = 0x02D0B948
blank_stub = 0x02D051A0
