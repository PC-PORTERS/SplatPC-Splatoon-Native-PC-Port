[hooks]
# Guest function entries wrapped so the port can attach opt-in host hooks.
hash = 0xCF6D189A67249B01
0x0242A8F8 = hook  # plaza frame-rate sync
0x0285C3D0 = hook  # message broadcast loop guard (GamePad touch freeze)

[patches]
# 0xADDR = instruction, applied before recompilation.
# The instruction is PowerPC assembly (cmpwi, li, stw, b, ...).
# Branch targets are absolute guest addresses.
hash = Undefined

[globals]
# Guest addresses the port code needs by name (not covered by a hash).
# rbrew_game_address() and the RBREW_GAME_* constants are generated from this section.
allocator            = 0x101EFCC8
sda                  = 0x10277580
ctors                = 0x101DB94C
ctors_done           = 0x101E922C
tls_handle           = 0x101E6AF0
plt_begin            = 0x02DD0000
plt_end              = 0x02DE0000
heap_alloc_slot      = 0x02DD6E78
heap_alloc_ex_slot   = 0x02DD6E80
heap_free_slot       = 0x02DD6E88
fopen_max_slot       = 0x02DD6EC8
plaza_half_rate_function = 0x0242A8F8
plaza_half_rate_return = 0x0242B0A0
render_manager = 0x101E7BDC
blank_stub = 0x02DD0720
broadcast_dispatch = 0x0285C3D0
broadcast_set_current = 0x0285BD54

[branch_tables]
# Jump tables made of `b` instructions (bctr to base + 4 * index): table base = the case block
# each slot branches to, one per slot. hooks/branch_tables.cpp links every slot to its block.
